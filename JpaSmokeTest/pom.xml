<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.ucaiug.cimtool</groupId>
  <artifactId>jpa-smoke-test</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>CIMTool JPA Smoke Test</name>
  <description>
    Smoke/regression test harness for the CIMTool jpa-rdfs.xsl builder.
    Compiles the generated SampleProfile.jpa-rdfs.java and validates its JPA
    behavior against the SQL DDL generated by sql-rdfs-ansi92.xsl, mirroring
    the EfCoreSmokeTest C# harness.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <hibernate.version>6.6.4.Final</hibernate.version>
    <h2.version>2.3.232</h2.version>
    <!-- Location of the CIMTool-generated fixtures (shared with the C# harness) -->
    <profiles.dir>${project.basedir}/../CSharpEFTestProject/CSharpEFTestProject/Profiles</profiles.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <version>${hibernate.version}</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.16</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Copies the CIMTool-generated Java into generated-sources under a valid
           compilation-unit name (SampleProfile.jpa-rdfs.java is not one).
           Fails fast with instructions when the fixture has not been generated. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>import-generated-java</id>
            <phase>generate-sources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <fail message="Missing generated fixture: ${profiles.dir}/SampleProfile.jpa-rdfs.java.${line.separator}Generate it with CIMTool (jpa-rdfs builder enabled on Profiles/SampleProfile.owl) or run ./regen-fixtures.sh — see JpaSmokeTest/README.md.">
                  <condition>
                    <not><available file="${profiles.dir}/SampleProfile.jpa-rdfs.java"/></not>
                  </condition>
                </fail>
                <copy file="${profiles.dir}/SampleProfile.jpa-rdfs.java"
                      tofile="${project.build.directory}/generated-sources/cimtool/io/ucaiug/cimtool/generated/SampleProfile.java"
                      overwrite="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-generated-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${project.build.directory}/generated-sources/cimtool</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>io.ucaiug.cimtool.jpasmoketest.JpaSmokeTest</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
